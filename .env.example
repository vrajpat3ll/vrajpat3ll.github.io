# Last.fm API key — used client-side by the now-playing widget.
# Get one at https://www.last.fm/api/account/create
# Note: this key is bundled into the client, which is expected for Last.fm.
NEXT_PUBLIC_LASTFM_API_KEY=

# GitHub token with read-only `read:user` scope — used at build time to fetch
# the contribution calendar via the GraphQL API. Optional: without it the site
# falls back to the public github-contributions-api.
# The default GITHUB_TOKEN provided by Actions also works if you grant it
# `read:user`; see the deploy workflow.
GH_CONTRIB_TOKEN=
